# Copia este archivo a .env fuera del repositorio y sustituye los valores.
ADMIN_TOKEN=genera_una_clave_de_al_menos_32_bytes
BUZON_PEDIDOS=pedidos@hardtocrack.com

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=usuario_smtp
SMTP_PASS=clave_smtp
SMTP_FROM=pedidos@hardtocrack.com

# Déjalo vacío si web y API comparten dominio. Nunca uses * en producción.
ALLOWED_ORIGINS=
REGISTRO_TIENDAS=/opt/hardtocrack-pedidos/registro/tiendas.csv
REGISTRO_EVENTOS=/opt/hardtocrack-pedidos/registro/eventos.csv
REGISTRO_PEDIDOS=/opt/hardtocrack-pedidos/registros
