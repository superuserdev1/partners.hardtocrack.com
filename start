<!-- ============ POR QUÉ HARDTOCRACK ============ -->
<section id="por-que">
  <div class="container">
    <div class="section-head reveal">
      <div class="eyebrow" style="justify-content:center">¿Por qué HardToCrack?</div>
      <h2>Cuatro razones para colaborar</h2>
    </div>
    <div class="grid-4 reveal">
      <div class="card">
        <div class="card-top-line"></div>
